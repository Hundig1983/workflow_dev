# Copy to .env and adjust. Never commit .env — it is gitignored.
# No value here is a secret. EXPO_PUBLIC_* vars are embedded in the client bundle
# and are therefore readable by anyone with the app — never put a credential here.

# Base URL of the FamilyHub API.
# Default (used when unset) is http://127.0.0.1:3000 — the local backend.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
