# Copy to .env and fill in. Never commit .env — it is gitignored.
# No value here is a real credential; these are local-development placeholders.

# --- Database ---
# The API connects to PostgreSQL with this URL. In the Docker Compose stack the
# host is the `postgres` service name; running the API outside Docker it is localhost.
DATABASE_URL=postgres://familyhub:change-me-locally@localhost:5432/familyhub

# Values used by the postgres container in docker-compose.yml.
POSTGRES_USER=familyhub
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=familyhub

# --- HTTP ---
PORT=3000
HOST=0.0.0.0

# --- Sessions ---
# How long a session stays valid after it is issued.
SESSION_TTL_HOURS=720

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
